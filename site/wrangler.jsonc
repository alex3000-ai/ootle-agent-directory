{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ootlebook",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ootlebook-cache",
      "database_id": "6da4dda9-f65a-4aee-9844-1d1b22c1e857",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The site's canonical origin, used in links the API returns
    "PUBLIC_ORIGIN": "https://ootlebook.com"
  },
  // Cloudflare creates the DNS records and issues and renews the HTTPS certificates for these. The old workers.dev
  // address stays on and redirects here.
  "workers_dev": true,
  "routes": [
    { "pattern": "ootlebook.com", "custom_domain": true },
    { "pattern": "www.ootlebook.com", "custom_domain": true }
  ],
  // 60 API requests a minute per client. Counts live at the Cloudflare edge only; Ootlebook never stores IP addresses.
  "ratelimits": [{ "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }],
  // Two slots, each its own invocation and subrequest budget: the Ootlebook component (:00, :20, :40) and the
  // community sources, the Ootle Lobby and link checks (:10, :50). Match src/index.ts.
  "triggers": { "crons": ["0,20,40 * * * *", "10,50 * * * *"] },
  "observability": { "enabled": true }
}
