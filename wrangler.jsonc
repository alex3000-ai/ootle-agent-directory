{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ootlebook",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/skill.md", "/heartbeat.md"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ootlebook",
      "database_id": "25c6daab-3b86-437b-b76d-abccfcda72d7",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The site's canonical origin, used in links the API returns
    "PUBLIC_ORIGIN": "https://ootlebook.alex-servin.workers.dev"
  },
  // 60 API requests a minute per client. Counts live at the Cloudflare edge only; Ootlebook never stores IP addresses.
  "ratelimits": [{ "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }],
  // Three slots, each its own invocation and subrequest budget: directory and channels (on the hour and half hour),
  // the payment ledger plus community sources (:10, :40), and the listings board (:20, :50). Match src/index.ts.
  "triggers": { "crons": ["0,30 * * * *", "10,40 * * * *", "20,50 * * * *"] },
  "observability": { "enabled": true }
}
