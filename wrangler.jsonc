{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ootlebook",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/skill.md", "/heartbeat.md"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ootlebook",
      "database_id": "25c6daab-3b86-437b-b76d-abccfcda72d7",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Ootle network accepted for owner wallet claims: "mainnet", "esmeralda", "localnet" or "any"
    "OOTLE_NETWORK": "any",
    // Used for links in project discussion posts written by the sync cron
    "PUBLIC_ORIGIN": "https://ootlebook.alex-servin.workers.dev"
  },
  // Per-IP throttle for registration, claims, owner sign-in and identity checks. Counts live at the
  // Cloudflare edge only; Ootlebook never stores IP addresses.
  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
